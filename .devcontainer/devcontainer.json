// Phase 2.1 — devcontainer.json for the locked-down LLM dev machines
// (llm-notes/plans/ai-dev-machine-kubevirt-plan.md). devpod's SSH provider
// builds/runs this as a plain runc container *inside* the KubeVirt VM, which is
// the security boundary — so the container itself needs no isolation hardening.
//
// The image is built with Nix (packages/dev-machine-dev-image) and pinned from
// creil; it carries the dev tooling. NO devcontainer "features" — features
// apt-install at build time, which is exactly the heavyweight path the plan
// rejects; everything is baked into the Nix image instead.
{
  "name": "dotfiles-dev-machine",
  "image": "forgejo.internal/mutantmell/dev-machine-dev:latest",

  // --device=/dev/kvm: surface the VM's /dev/kvm into the inner container so this
  //   flake's nixosTest suite (./scripts/run-checks.sh) runs nested with fast
  //   local feedback — the hard requirement that drove the whole KubeVirt-VM
  //   substrate decision.
  // --cap-add=SYS_ADMIN: let Nix open its build sandbox. docker's default seccomp
  //   profile blocks the unshare/clone of mount+user namespaces (and mount()
  //   itself) unless CAP_SYS_ADMIN is held; without it Nix can't sandbox and the
  //   image is forced to sandbox=false, which leaks /homeless-shelter on a killed
  //   build (the orphan that wedges every later build). With the cap, the dev
  //   image flips to sandbox=true and the orphan becomes structurally impossible
  //   — /homeless-shelter then lives inside each build's private mount namespace.
  //   CAP_SYS_ADMIN is the only missing piece (docker already grants SYS_CHROOT /
  //   MKNOD / SETUID / SETGID) and there is no finer-grained capability for the
  //   mount ops. Granting it weakens only the container->VM-root boundary, which
  //   this design does not treat as a trust boundary: the VM (KVM) plus the
  //   namespace-level NetworkPolicy egress lockdown are the real containment, and
  //   neither is affected by an inner-container capability.
  "runArgs": ["--device=/dev/kvm", "--cap-add=SYS_ADMIN"],

  // Keep postCreate minimal (plan). The workspace is bind-mounted, so git would
  // otherwise refuse to operate on a dir owned by a different uid.
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}"
}
