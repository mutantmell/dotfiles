// Phase 2.1 — devcontainer.json for the locked-down LLM dev machines
// (llm-notes/plans/ai-dev-machine-kubevirt-plan.md). devpod's SSH provider
// builds/runs this as a plain runc container *inside* the KubeVirt VM, which is
// the security boundary.
//
// The image is built with Nix (packages/dev-machine-dev-image) and pinned from
// creil; it carries the dev tooling. NO devcontainer "features" — features
// apt-install at build time, which is exactly the heavyweight path the plan
// rejects; everything is baked into the Nix image instead.
{
  "name": "dotfiles-dev-machine",
  "image": "forgejo.internal/mutantmell/dev-machine-dev:latest",
  "remoteUser": "agent",
  "updateRemoteUserUID": false,
  "overrideCommand": false,

  // --device=/dev/kvm: surface the VM's /dev/kvm into the inner container so this
  //   flake's nixosTest suite (./scripts/run-checks.sh) runs nested with fast
  //   local feedback — the hard requirement that drove the whole KubeVirt-VM
  //   substrate decision.
  // --cap-add=SYS_ADMIN: let Nix open its build sandbox. Docker's default
  //   capability set is missing the mount namespace privileges Nix needs.
  // --cgroupns=host + /run/nix-cgroup rw: let the root-owned nix-daemon create
  //   per-build cgroups for auto-allocated UID ranges. Docker cannot reliably
  //   provide a writable cgroup v2 tree inside a private cgroup namespace; binding
  //   the VM's cgroupfs while also using a private namespace makes Nix see "/"
  //   as its cgroup but operate on a mount sourced outside that namespace, which
  //   breaks uid-range builds. The bind target deliberately stays outside /sys:
  //   Nix uid-range builds mount a fresh sysfs inside their build sandbox, and
  //   sysfs child mounts such as /sys/fs/cgroup can make that fail with EPERM.
  //   Sharing the VM's cgroup namespace is acceptable here because the KubeVirt
  //   VM is the security boundary.
  // --tmpfs=/sys: hide Docker's default sysfs/cgroup mount stack from the outer
  //   devcontainer. Nix creates the sysfs instance it needs inside each uid-range
  //   build sandbox; keeping the outer /sys as plain tmpfs avoids inherited
  //   sysfs child mounts that make that later mount fail.
  // --security-opt=seccomp=...: keep seccomp enabled but use a profile that
  //   permits pivot_root, which bubblewrap needs for Codex's own command
  //   sandbox. Docker resolves this path on the VM host, so the base VM image
  //   installs it under /etc/docker.
  // --security-opt=systempaths=unconfined: let Nix create a fresh mount+PID
  //   namespace and remount /proc for sandboxed builds. Docker's default
  //   masked/read-only /proc overlays make Nix conclude sandbox namespaces are
  //   unsupported, which breaks nix develop and container-backed NixOS tests.
  // --security-opt=apparmor=unconfined: keep Docker seccomp active, but do not
  //   apply Docker's default AppArmor profile. Nix uid-range builds mount a fresh
  //   sysfs inside their build sandbox; AppArmor can deny that even when the
  //   container has CAP_SYS_ADMIN and a seccomp profile that permits mount(2).
  "runArgs": [
    "--device=/dev/kvm",
    "--cap-add=SYS_ADMIN",
    "--cgroupns=host",
    "--mount=type=bind,source=/sys/fs/cgroup,target=/run/nix-cgroup",
    "--tmpfs=/sys:ro,nosuid,nodev,noexec",
    "--security-opt=seccomp=/etc/docker/seccomp-codex-bwrap.json",
    "--security-opt=systempaths=unconfined",
    "--security-opt=apparmor=unconfined"
  ],

  // Keep postCreate minimal (plan). The workspace is bind-mounted, so git would
  // otherwise refuse to operate on a dir owned by a different uid. This runs as
  // the non-root remoteUser and writes /home/agent/.gitconfig. The agent uid/gid
  // are baked into the Nix image, so disable DevPod's passwd/group rewrite path.
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}"
}
